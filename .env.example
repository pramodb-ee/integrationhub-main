# Optional. Leave unset to use the included demo Google Ads linking API route.
NEXT_PUBLIC_GOOGLE_ADS_LINK_ENDPOINT=

# Public webhook URL displayed in the Google Ads setup flow.
NEXT_PUBLIC_GOOGLE_ADS_WEBHOOK_URL=https://your-domain.example/api/webhooks/google-ads

# Optional local development watcher exclusions, separated by commas.
WATCH_IGNORED_PATHS=
